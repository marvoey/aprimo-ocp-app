# Copy to .env and fill in. Never commit .env.

# Aprimo environment host (Marketing Ops domain, not the .dam. address)
APRIMO_TENANT_DOMAIN=yourcompany.aprimo.com

# OAuth client registered in Aprimo: Administration > Integration > Registrations (flow type: Client Credentials)
APRIMO_CLIENT_ID=
APRIMO_CLIENT_SECRET=

# Only needed for the Resource Owner Password flow (My Profile > User Token); not used by this app
APRIMO_USERNAME=
APRIMO_USER_TOKEN=
